{
  "name": "flue-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:cloudflare",
    "build:cloudflare": "flue build --target cloudflare",
    "build:node": "flue build --target node --output dist-node",
    "dev": "flue dev --target cloudflare",
    "dev:node": "flue dev --target node",
    "start:node": "node dist-node/server.mjs",
    "auth:sync-codex": "node scripts/sync-codex-auth.mjs",
    "runner:deploy:daytona": "node scripts/deploy-daytona-runner.mjs",
    "deploy": "npm run build:cloudflare && wrangler deploy --config dist/flue_factory/wrangler.json",
    "deploy:dry-run": "npm run build:cloudflare && wrangler deploy --dry-run --config dist/flue_factory/wrangler.json",
    "smoke:production": "node scripts/smoke-production.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build:cloudflare && npm run build:node"
  },
  "dependencies": {
    "@daytona/sdk": "0.187.0",
    "@earendil-works/pi-ai": "0.79.6",
    "@flue/runtime": "1.0.0-beta.1",
    "agents": "^0.14.1",
    "hono": "4.12.23",
    "valibot": "1.4.1"
  },
  "devDependencies": {
    "@flue/cli": "1.0.0-beta.1",
    "typescript": "^5.9.3",
    "wrangler": "4.73.0"
  }
}
