{
  "name": "flue-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "flue build --target cloudflare",
    "dev": "flue dev --target cloudflare",
    "deploy": "npm run build && wrangler deploy --config .flue-vite.wrangler.jsonc",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run --config .flue-vite.wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@flue/runtime": "1.0.0-beta.1",
    "agents": "^0.14.1",
    "hono": "4.12.23",
    "valibot": "1.4.1"
  },
  "devDependencies": {
    "@flue/cli": "1.0.0-beta.1",
    "typescript": "^5.9.3",
    "wrangler": "4.73.0"
  }
}
