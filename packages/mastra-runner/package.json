{
  "name": "@open-inspect/mastra-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "open-inspect-mastra-runner": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
